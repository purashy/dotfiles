{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ╭──────────────────────────────────────────────────────╮
    // │                       LOGO                           │
    // ╰──────────────────────────────────────────────────────╯

    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
        "padding": {
            "top": 1,
            "right": 3
        },
        "color": {
            "1": "38;2;255;105;180",
            "2": "38;2;217;70;239",
            "3": "38;2;168;85;247",
            "4": "38;2;99;102;241",
            "5": "38;2;34;211;238"
        }
    },

    // ╭──────────────────────────────────────────────────────╮
    // │                      DISPLAY                         │
    // ╰──────────────────────────────────────────────────────╯

    "display": {
        "separator": "  "
    },

    // ╭──────────────────────────────────────────────────────╮
    // │                      MODULES                         │
    // ╰──────────────────────────────────────────────────────╯

    "modules": [
        "break",
        "break",

        // ────────────────────────────────────────────────────
        // Operating system
        // ────────────────────────────────────────────────────

        {
            "type": "os",
            "key": "",
            "keyColor": "38;2;255;105;180"
        },

        {
            "type": "kernel",
            "key": "",
            "keyColor": "38;2;217;70;239"
        },

        {
            "type": "packages",
            "key": "󰏗",
            "keyColor": "38;2;168;85;247"
        },

        {
            "type": "shell",
            "key": "",
            "keyColor": "38;2;99;102;241"
        },

        {
            "type": "de",
            "key": "",
            "keyColor": "38;2;34;211;238"
        },
        "break",

        // ────────────────────────────────────────────────────
        // Hardware
        // ────────────────────────────────────────────────────

        {
            "type": "cpu",
            "key": "󰍛",
            "format": "{1}",
            "keyColor": "38;2;255;105;180"
        },

        {
            "type": "gpu",
            "key": "󰢮",
            "format": "{2}",
            "keyColor": "38;2;217;70;239"
        },

        {
            "type": "memory",
            "key": "󰘚",
            "keyColor": "38;2;168;85;247"
        },
        "break",

        // ────────────────────────────────────────────────────
        // Runtime
        // ────────────────────────────────────────────────────

        {
            "type": "uptime",
            "key": "",
            "keyColor": "38;2;99;102;241"
        },

        {
            "type": "command",
            "key": "",
            "keyColor": "38;2;34;211;238",
            "text": "birth=$(stat -c %W / 2>/dev/null); if [ \"$birth\" -gt 0 ] 2>/dev/null; then echo \"$(( ($(date +%s) - birth) / 86400 )) days\"; else echo 'unknown'; fi"
        },

        "break"
    ]
}
